{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app22",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "ed4ec0b3-d266-4cce-8e96-fda4e3ec4e2b","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "bd2f8a665c4c4127baeabaa201db27f1" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
